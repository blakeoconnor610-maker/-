# ---- required ----
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=paste_your_bot_token_here

# ---- optional ----
# Your own Discord user ID. Gives you access to owner-only commands (/sync, /shutdown).
OWNER_ID=

# Put your server's ID here while you're testing. Slash commands appear
# instantly in that one server instead of taking up to an hour globally.
DEV_GUILD_ID=

# Where the sqlite database lives.
DATABASE_PATH=data/bot.db

# ---- control panel ----
# Powers the Android app in android/ (and works in any phone browser): pick a
# channel, type as the bot, and flip the bot's settings. Turn it on here, then
# restart. See "The app" in the readme before exposing it to the internet.
PANEL_ENABLED=false
PANEL_HOST=0.0.0.0
PANEL_PORT=8080
# Long random string. This is the ONLY thing protecting the panel - make it good.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PANEL_PASSWORD=
